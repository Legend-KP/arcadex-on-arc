# Admin portal (set your own; do not use production values in examples)
NEXT_PUBLIC_ADMIN_PASSWORD=
ADMIN_PASSWORD=
NEXT_PUBLIC_APP_URL=https://arcx.trenchverse.com
NEXT_PUBLIC_ADMIN_HOST=admin.arcx.trenchverse.com

# Arc mainnet (chain id 5042)
NEXT_PUBLIC_CHAIN_ID=5042
# Public RPCs rate-limit — prefer a dedicated provider for ARC_RPC_URL (server/Worker).
# Browser traffic goes through /api/rpc which failovers across public endpoints.
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.mainnet.arc.io
ARC_RPC_URL=
# Optional comma-separated extras before public failover list:
# ARC_RPC_FALLBACK_URLS=https://rpc.blockdaemon.mainnet.arc.io,https://rpc.drpc.mainnet.arc.io
# ARC_RPC_API_KEY=
NEXT_PUBLIC_SPARK_REFILL_CONTRACT=0x07FBF1bC8DF68C057fD4d7D1D7F57fADee6A5f0E
NEXT_PUBLIC_SCORE_SUBMIT_CONTRACT=0x393A322846Cb9b95E9aFC6521e727Cf6C8af8501
NEXT_PUBLIC_INFINITE_SPARK_CONTRACT=0x54CfCe40CaeF51b986DAf9abbc0C6dea0fA40a35
NEXT_PUBLIC_ARCADEX_TX_HUB_CONTRACT=0x5282cbB845006F9ecE9d042153A6C4Dc806347aa
NEXT_PUBLIC_ARCADEX_REWARDS_CONTRACT=0x10E69E455BCA4606B8820d342d3e52c01C17049c

# Streak / daily play
