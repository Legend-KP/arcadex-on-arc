DAILY_PLAY_MODE=streak
NEXT_PUBLIC_DAILY_PLAY_MODE=streak
SHUFFLE_CAMPAIGN_ID=3
NEXT_PUBLIC_SHUFFLE_CAMPAIGN_ID=3

# Deployer key (Hardhat only) + shuffle spin signer — never commit real keys
