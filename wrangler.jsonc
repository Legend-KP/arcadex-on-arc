{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "worker.mjs",
	"name": "arcadex-arc",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	/**
	 * Arc Worker + D1 — separate from live arcadex-celo / MiniPay.
	 *
	 * Deploy:
	 *   npm run deploy:preview
	 *   npm run deploy:production
	 */
	"env": {
		"preview": {
			"name": "arcadex-arc-preview",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"NEXT_PUBLIC_CHAIN_ID": "5042",
				"NEXT_PUBLIC_ARC_RPC_URL": "https://rpc.mainnet.arc.io",
				"NEXT_PUBLIC_APP_URL": "https://arcx.trenchverse.com",
				"NEXT_PUBLIC_ADMIN_HOST": "admin.arcx.trenchverse.com",
				"NEXT_PUBLIC_SPARK_REFILL_CONTRACT": "0x07FBF1bC8DF68C057fD4d7D1D7F57fADee6A5f0E",
				"NEXT_PUBLIC_SCORE_SUBMIT_CONTRACT": "0x393A322846Cb9b95E9aFC6521e727Cf6C8af8501",
				"NEXT_PUBLIC_INFINITE_SPARK_CONTRACT": "0x54CfCe40CaeF51b986DAf9abbc0C6dea0fA40a35",
				"NEXT_PUBLIC_ARCADEX_TX_HUB_CONTRACT": "0x5282cbB845006F9ecE9d042153A6C4Dc806347aa",
				"NEXT_PUBLIC_ARCADEX_REWARDS_CONTRACT": "0x10E69E455BCA4606B8820d342d3e52c01C17049c",
				"NEXT_PUBLIC_STREAK_CAMPAIGN_ID": "1",
				"DAILY_PLAY_MODE": "streak",
				"NEXT_PUBLIC_DAILY_PLAY_MODE": "streak"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-arc-preview"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "0f19cabb73844762a768ee1dd6e8e53b"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-arc-preview",
					"database_id": "0b2219a2-ab94-4fbf-bfff-87f05d3eeaa2",
					"migrations_dir": "migrations",
					"preview_database_id": "arcadex-arc-preview-local"
				}
			]
		},
		"production": {
			"name": "arcadex-arc",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"NEXT_PUBLIC_CHAIN_ID": "5042",
				"NEXT_PUBLIC_ARC_RPC_URL": "https://rpc.mainnet.arc.io",
				"NEXT_PUBLIC_APP_URL": "https://arcx.trenchverse.com",
				"NEXT_PUBLIC_ADMIN_HOST": "admin.arcx.trenchverse.com",
				"NEXT_PUBLIC_SPARK_REFILL_CONTRACT": "0x07FBF1bC8DF68C057fD4d7D1D7F57fADee6A5f0E",
				"NEXT_PUBLIC_SCORE_SUBMIT_CONTRACT": "0x393A322846Cb9b95E9aFC6521e727Cf6C8af8501",
				"NEXT_PUBLIC_INFINITE_SPARK_CONTRACT": "0x54CfCe40CaeF51b986DAf9abbc0C6dea0fA40a35",
				"NEXT_PUBLIC_ARCADEX_TX_HUB_CONTRACT": "0x5282cbB845006F9ecE9d042153A6C4Dc806347aa",
				"NEXT_PUBLIC_ARCADEX_REWARDS_CONTRACT": "0x10E69E455BCA4606B8820d342d3e52c01C17049c",
				"NEXT_PUBLIC_STREAK_CAMPAIGN_ID": "1",
				"DAILY_PLAY_MODE": "streak",
				"NEXT_PUBLIC_DAILY_PLAY_MODE": "streak"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-arc"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "8a833e80dae74b879e383945f1c2f7ae"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-arc-prod",
					"database_id": "2f60fea6-cdc5-4383-b15d-581021b05ae4",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
