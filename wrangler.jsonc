{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "arcadex-arc",
	"compatibility_date": "2026-01-01",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"keep_vars": true,
	"observability": {
		"enabled": true
	},
	/**
	 * NEW Arc Worker + D1 — placeholders only.
	 * Do NOT point these at live arcadex-celo / MiniPay D1 ids.
	 * Create new Cloudflare Worker names + D1 databases, then fill the ids.
	 *
	 * Deploy:
	 *   npm run deploy:preview
	 *   npm run deploy:production
	 */
	"env": {
		"preview": {
			"name": "arcadex-arc-preview",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"NEXT_PUBLIC_CHAIN_ID": "5042",
				"NEXT_PUBLIC_ARC_RPC_URL": "https://rpc.mainnet.arc.io"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-arc-preview"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "REPLACE_WITH_NEW_ARC_PREVIEW_KV_ID"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-arc-preview",
					"database_id": "REPLACE_WITH_NEW_ARC_PREVIEW_D1_ID",
					"migrations_dir": "migrations",
					"preview_database_id": "arcadex-arc-preview-local"
				}
			]
		},
		"production": {
			"name": "arcadex-arc",
			"vars": {
				"PLAYER_DATA_BACKEND": "d1",
				"NEXT_PUBLIC_CHAIN_ID": "5042",
				"NEXT_PUBLIC_ARC_RPC_URL": "https://rpc.mainnet.arc.io"
			},
			"services": [
				{
					"binding": "WORKER_SELF_REFERENCE",
					"service": "arcadex-arc"
				}
			],
			"kv_namespaces": [
				{
					"binding": "RATE_LIMIT_KV",
					"id": "REPLACE_WITH_NEW_ARC_PROD_KV_ID"
				}
			],
			"d1_databases": [
				{
					"binding": "DB",
					"database_name": "arcadex-arc-prod",
					"database_id": "REPLACE_WITH_NEW_ARC_PROD_D1_ID",
					"migrations_dir": "migrations"
				}
			]
		}
	}
}
